# Kopieren nach deploy/deploy.env (steht in .gitignore) und anpassen; wird von deploy.sh gelesen.
# Umgebungsvariablen gleichen Namens haben Vorrang.

# ssh-Ziel des Servers (Host oder Alias aus ~/.ssh/config)
DEPLOY_HOST=my-server
# Verzeichnis auf dem Server (darin: .env, app/, live/, work/)
DEPLOY_DIR=/srv/capercailye
