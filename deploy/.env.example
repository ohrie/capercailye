# Kopieren nach deploy/.env und anpassen (deploy/.env steht in .gitignore).

# Öffentlicher Hostname der Seite; kommt in die Traefik-Regel und in canonical/og:/sitemap der
# Landingpage (Build-Arg, daher nach einer Änderung neu bauen: docker compose up -d --build).
DOMAIN=karte.example.com

# Docker-Netzwerk, in dem Traefik hängt (docker network ls)
TRAEFIK_NETWORK=proxy
# Name des HTTPS-Entrypoints in der Traefik-Konfiguration
TRAEFIK_ENTRYPOINT=websecure
# Name des Zertifikats-Resolvers (ACME) in der Traefik-Konfiguration
TRAEFIK_CERTRESOLVER=letsencrypt

# Datenverzeichnis auf dem Host; darunter live/ (PMTiles, wird ausgeliefert) und work/ (Updater)
DATA_ROOT=/srv/capercailye

# --- Updater (wöchentlicher Neuaufbau, Dienstag 02:23 Europe/Berlin) ---
# Java-Heap für Planetiler; die Speichergrenze des Containers steht als mem_limit in compose.yaml
JAVA_XMX=6g
# CPU-Kerne für den Updater (auch Planetiler-Threads); mindestens einen Kern für nginx frei lassen
UPDATER_CPUS=4
# Optional: Healthcheck-URL (z. B. healthchecks.io), wird nach dem Lauf angepingt, bei Fehler mit /fail
HEALTHCHECK_URL=
