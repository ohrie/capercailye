# Auf dem Server nach /srv/capercailye/.env kopieren und anpassen (deploy/.env steht in .gitignore).
# deploy.sh überschreibt die .env auf dem Server nie.

# Öffentlicher Hostname der Seite für die Traefik-Regel.
DOMAIN=karte.example.org

# Datenverzeichnis auf dem Host; darunter live/ (PMTiles, wird ausgeliefert) und work/ (Updater)
DATA_ROOT=/srv/capercailye

# Optional: Entrypoint und Zertifikats-Resolver des Traefik (Standard: websecure / letsencrypt)
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt

# --- Updater (wöchentlicher Neuaufbau, Dienstag 02:23 Europe/Berlin) ---
# Speichergrenzen an den Server anpassen: Der Updater darf UPDATER_MEM_LIMIT belegen, der Java-Heap
# von Planetiler (JAVA_XMX) liegt deutlich darunter (Rest: Seitencache für die mmap-Dateien, bun,
# tippecanoe).
JAVA_XMX=3g
UPDATER_MEM_LIMIT=5g
# CPU-Kerne für den Updater (auch Planetiler-Threads); mindestens einen Kern für nginx frei lassen
UPDATER_CPUS=4
# Optional: Healthcheck-URL (z. B. healthchecks.io), wird nach dem Lauf angepingt, bei Fehler mit /fail
HEALTHCHECK_URL=
