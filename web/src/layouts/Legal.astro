---
// Legal pages (German): header with link to the app, `main.legal` and the site footer.
import LangSelect from "../components/LangSelect.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Site from "./Site.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Site title={title} lang="de" noindex>
  <script slot="head" defer src="/mail.js" is:inline></script>

  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/" aria-label="capercailye, Startseite">
        <img src="/logo.svg" width="32" height="32" alt="" />
        <span class="brand__name">capercailye</span>
      </a>
      <nav class="nav" aria-label="Hauptmenü">
        <!-- The legal texts exist only in German: choosing a language stores it and opens the landing
             page in that language. -->
        <LangSelect locale="de" targets={{ en: "/", de: "/de/" }} />
        <a class="btn btn--small" href="/app/">Karte öffnen</a>
      </nav>
    </div>
  </header>

  <main class="legal">
    <div class="wrap">
      <slot />
    </div>
  </main>

  <SiteFooter locale="de" />
</Site>
