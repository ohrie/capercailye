---
// Legal pages (German): header with link to the app, `main.legal` and the legal footer.
import SiteFooter from "../components/SiteFooter.astro";
import Site from "./Site.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Site title={title} lang="de" noindex>
  <script slot="head" defer src="/mail.js" is:inline></script>

  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/" aria-label="capercailye, Startseite">
        <img src="/logo.svg" width="32" height="32" alt="" />
        capercailye
      </a>
      <nav class="nav" aria-label="Hauptmenü">
        <a class="btn btn--small" href="/app/">Karte öffnen</a>
      </nav>
    </div>
  </header>

  <main class="legal">
    <div class="wrap">
      <slot />
    </div>
  </main>

  <SiteFooter>
    <a href="/impressum/">Impressum</a> · <a href="/datenschutz/">Datenschutz</a> ·
    <a href="/quellen/">Quellen und Lizenzen</a>
  </SiteFooter>
</Site>
