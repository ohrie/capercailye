---
// Footer of the landing and legal pages: brand, link columns (project, data, legal) and a bottom
// bar with the sign-off. Self-contained: texts come from Paraglide in the given locale.
import GitHubIcon from "./GitHubIcon.astro";
import { m } from "../paraglide/messages.js";
import type { Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const HOME: Record<Locale, string> = { en: "/", de: "/de/" };
// The legal pages are German only; the English footer says so (the German one needs no hint).
const germanOnly = locale !== "de";

// Twelve five-pointed stars of the EU flag on a circle, in a 18 x 12 viewBox.
const star = (cx: number, cy: number, r = 0.9) =>
  Array.from({ length: 10 }, (_, i) => {
    const a = (Math.PI / 5) * i - Math.PI / 2;
    const k = i % 2 === 0 ? r : r * 0.382;
    return `${(cx + k * Math.cos(a)).toFixed(2)},${(cy + k * Math.sin(a)).toFixed(2)}`;
  }).join(" ");
const STARS = Array.from({ length: 12 }, (_, i) => {
  const a = (Math.PI / 6) * i;
  return star(9 + 4 * Math.sin(a), 6 - 4 * Math.cos(a));
});
const t = (key: keyof typeof m): string =>
  (m[key] as (i: object, o: { locale: Locale }) => string)({}, { locale });
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <a class="site-footer__brand" href={HOME[locale]}>
        <img src="/logo.svg" width="24" height="24" alt="" />
        <span class="site-footer__name">
          capercailye
          <span class="site-footer__slogan">{t("landing_hero_title")}</span>
        </span>
      </a>
      <nav class="site-footer__nav" aria-label={t("footer_nav_label")}>
        <div class="site-footer__col">
          <h2>{t("footer_project")}</h2>
          <ul>
            <li><a href="/app/">{t("landing_open_map")}</a></li>
            <li>
              <a href="https://github.com/ohrie/capercailye">
                <GitHubIcon size={16} />
                GitHub
              </a>
            </li>
          </ul>
        </div>
        <div class="site-footer__col">
          <h2>{t("footer_data")}</h2>
          <ul>
            <li><a href="https://www.openstreetmap.org/copyright">{t("footer_osm")}</a></li>
            <li><a href="https://mapterhorn.com/">{t("footer_relief")}</a></li>
            <li><a href="https://photon.komoot.io/">{t("footer_search")}</a></li>
            <li><a href="/quellen/">{t("legal_sources")}</a></li>
          </ul>
        </div>
        <div class="site-footer__col">
          <h2>{t("footer_legal")}</h2>
          <ul>
            <li>
              <a href="/impressum/" hreflang="de">{t("legal_notice")}</a>
              {germanOnly && <span class="site-footer__note">{t("footer_german_only")}</span>}
            </li>
            <li>
              <a href="/datenschutz/" hreflang="de">{t("legal_privacy")}</a>
              {germanOnly && <span class="site-footer__note">{t("footer_german_only")}</span>}
            </li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="site-footer__bar">
      <p>
        {t("footer_made_with")}{" "}
        <svg
          class="site-footer__heart"
          viewBox="0 0 16 16"
          width="14"
          height="14"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M8 14.5 1.6 8.3a3.8 3.8 0 0 1 5.4-5.4l1 1 1-1a3.8 3.8 0 0 1 5.4 5.4z" />
        </svg>
        <span class="site-footer__sr">{t("footer_love")}</span>{" "}
        {t("footer_in")}{" "}
        <svg
          class="site-footer__flag"
          viewBox="0 0 18 12"
          width="18"
          height="12"
          aria-hidden="true"
        >
          <rect width="18" height="12" fill="#039" />
          {STARS.map((points) => <polygon points={points} fill="#fc0" />)}
        </svg>
        <span class="site-footer__sr">{t("footer_europe")}</span>
      </p>
    </div>
  </div>
</footer>
